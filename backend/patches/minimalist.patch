@@ -0,0 +1,261 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/keybase/client/go/chat"
+	"github.com/keybase/client/go/chat/globals"
+	"github.com/keybase/client/go/chat/storage"
+	"github.com/keybase/client/go/chat/types"
+	"github.com/keybase/client/go/ephemeral"
+	"github.com/keybase/client/go/externals"
+	"github.com/keybase/client/go/libkb"
+	"github.com/keybase/client/go/protocol/chat1"
+	"github.com/keybase/client/go/protocol/gregor1"
+	"github.com/keybase/client/go/protocol/keybase1"
+	"github.com/keybase/client/go/pvl"
+	"github.com/keybase/client/go/runtimestats"
+	"github.com/keybase/client/go/teambot"
+	"github.com/keybase/client/go/teams"
+	"github.com/keybase/go-framed-msgpack-rpc/rpc"
+)
+
+var errMinimalistDisabled = errors.New("feature disabled in minimalist build")
+
+// No attachment, wallet, filesystem, browser helper, search, bot or debugging
+// protocol is registered. Unknown methods fail before their request is decoded.
+func (d *Service) registerMinimalistProtocols(srv *rpc.Server, xp rpc.Transporter, connID libkb.ConnectionID, logReg *logRegister) error {
+	g := d.G()
+	cg := globals.NewContext(g, d.ChatG())
+	protocols := minimalistProtocolSet(
+		NewConfigHandler(xp, connID, g, d), NewLoginHandler(xp, g),
+		NewSignupHandler(xp, g), NewLogHandler(xp, logReg, g),
+		CancelingProtocol(g, minimalistChatProtocol(newChatLocalHandler(xp, cg, d.gregor)), libkb.RPCCancelerReasonAll))
+	for _, protocol := range protocols {
+		if err := srv.Register(protocol); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// The official CLI account flow uses these RPC entry points. Its engines
+// perform identity, device and key operations directly within the service;
+// registering the unrelated User/Device administration protocols is unnecessary.
+func minimalistProtocolSet(config keybase1.ConfigInterface, login keybase1.LoginInterface,
+	signup keybase1.SignupInterface, log keybase1.LogInterface, chatProtocol rpc.Protocol) []rpc.Protocol {
+	return []rpc.Protocol{
+		minimalistMethods(keybase1.ConfigProtocol(config), "getCurrentStatus", "getConfig", "helloIAm", "getAllProvisionedUsernames", "getRememberPassphrase"),
+		minimalistMethods(keybase1.LoginProtocol(login), "login", "logout"),
+		minimalistMethods(keybase1.SignupProtocol(signup), "signup", "inviteRequest", "getInvitationCode"),
+		minimalistMethods(keybase1.LogProtocol(log), "registerLogger"),
+		chatProtocol,
+	}
+}
+
+func minimalistChatProtocol(handler chat1.LocalInterface) rpc.Protocol {
+	return minimalistMethods(chat1.LocalProtocol(handler),
+		"getThreadLocal", "getInboxAndUnboxLocal", "getInboxAndUnboxUILocal", "getInboxSummaryForCLILocal", "getConversationForCLILocal",
+		"findConversationsLocal", "newConversationLocal", "getTLFConversationsLocal", "joinConversationByIDLocal",
+		"markAsReadLocal", "postLocal", "getUnfurlSettings", "saveUnfurlSettings")
+}
+
+func minimalistMethods(protocol rpc.Protocol, names ...string) rpc.Protocol {
+	methods := make(map[string]rpc.ServeHandlerDescription, len(names))
+	for _, name := range names {
+		if method, ok := protocol.Methods[name]; ok {
+			methods[name] = method
+		} else {
+			panic("minimalist protocol contains unknown method: " + protocol.Name + "." + name)
+		}
+	}
+	protocol.Methods = methods
+	return protocol
+}
+
+func (d *Service) setupMinimalistCriticalServices() error {
+	g := d.G()
+	mctx := d.MetaContext(context.Background())
+	g.RuntimeStats = runtimestats.NewRunner(globals.NewContext(g, d.ChatG()))
+	teams.ServiceInit(g)
+	pvl.NewPvlSourceAndInstall(g)
+	externals.NewParamProofStoreAndInstall(g)
+	externals.NewExternalURLStoreAndInstall(g)
+	ephemeral.ServiceInit(mctx)
+	teambot.ServiceInit(mctx)
+	g.SetAvatarLoader(minimalistAvatarLoader{})
+	return nil
+}
+
+func (d *Service) runMinimalistBackgroundOperations(uir *UIRouter) {
+	ctx := context.Background()
+	d.tryLogin(ctx, libkb.LoginAttemptOnline)
+	d.chatOutboxPurgeCheck()
+	d.hourlyChecks()
+	d.slowChecks()
+	d.startupGregor()
+	d.startChatModules()
+	d.addGlobalHooks()
+	d.configureRekey(uir)
+	// Preserve key rotation and team/merkle auditing; omit unrelated account
+	// recommendations, contacts, wallets, telemetry and home-screen polling.
+	d.runBackgroundPerUserKeyUpgrade()
+	d.runBackgroundPerUserKeyUpkeep()
+	d.runBackgroundBoxAuditRetry()
+	d.runBackgroundBoxAuditScheduler()
+	d.runTLFUpgrade()
+	d.runTeamUpgrader(ctx)
+	d.runMerkleAudit(ctx)
+}
+
+func (d *Service) setupMinimalistChatModules(ri func() chat1.RemoteInterface) {
+	g := globals.NewContext(d.G(), d.ChatG())
+	if ri == nil {
+		ri = d.gregor.GetClient
+	}
+	storage.SetupGlobalHooks(g)
+	g.CtxFactory = chat.NewCtxFactory(g)
+	g.Badger = d.badger
+	inbox := chat.NewInboxSource(g, g.Env.GetInboxSourceType(), ri)
+	g.InboxSource = inbox
+	d.badger.SetLocalChatState(inbox)
+	chatStorage := storage.New(g, nil)
+	g.ConvSource = chat.NewConversationSource(g, g.Env.GetConvSourceType(), chat.NewBoxer(g), chatStorage, ri)
+	chatStorage.SetAssetDeleter(g.ConvSource)
+	g.Indexer = types.DummyIndexer{}
+	g.ServerCacheVersions = storage.NewServerVersions(g)
+	syncer := chat.NewSyncer(g)
+	g.Syncer = syncer
+	g.FetchRetrier = chat.NewFetchRetrier(g)
+	g.ConvLoader = chat.NewBackgroundConvLoader(g)
+	g.EphemeralPurger = chat.NewBackgroundEphemeralPurger(g)
+	g.EphemeralTracker = chat.NewEphemeralTracker(g)
+	g.AddLogoutHook(g.EphemeralTracker, "EphemeralTracker")
+	g.AddDbNukeHook(g.EphemeralTracker, "EphemeralTracker")
+	g.ActivityNotifier = chat.NewNotifyRouterActivityRouter(g)
+	d.badger.SetInboxVersionSource(storage.NewInboxVersionSource(g))
+	g.PushHandler = chat.NewPushHandler(g)
+	g.AttachmentUploader = types.DummyAttachmentUploader{}
+	g.AttachmentURLSrv = types.DummyAttachmentHTTPSrv{}
+	sender := chat.NewBlockingSender(g, chat.NewBoxer(g), ri)
+	g.MessageDeliverer = chat.NewDeliverer(g, sender, d.gregor)
+	g.TeamChannelSource = chat.NewTeamChannelSource(g)
+	g.AddLogoutHook(g.TeamChannelSource, "TeamChannelSource")
+	g.AddDbNukeHook(g.TeamChannelSource, "TeamChannelSource")
+	g.StellarLoader = types.DummyStellarLoader{}
+	g.StellarSender = types.DummyStellarSender{}
+	g.Unfurler = minimalistUnfurler{}
+	g.CommandsSource = minimalistCommands{}
+	g.CoinFlipManager = types.DummyCoinFlipManager{}
+	g.TeamMentionLoader = types.DummyTeamMentionLoader{}
+	g.ExternalAPIKeySource = types.DummyExternalAPIKeySource{}
+	g.LiveLocationTracker = minimalistLocation{}
+	g.BotCommandManager = types.DummyBotCommandManager{}
+	g.UIInboxLoader = types.DummyUIInboxLoader{}
+	g.UIThreadLoader = &minimalistThreadLoader{UIThreadLoader: chat.NewUIThreadLoader(g, ri)}
+	g.ParticipantsSource = chat.NewCachingParticipantSource(g, ri)
+	g.EmojiSource = types.DummyEmojiSource{}
+	syncer.RegisterOfflinable(g.InboxSource)
+	syncer.RegisterOfflinable(g.UIThreadLoader)
+	syncer.RegisterOfflinable(g.FetchRetrier)
+	syncer.RegisterOfflinable(g.MessageDeliverer)
+	g.AddUserChangedHandler(chat.NewIdentifyChangedHandler(g))
+	g.ChatHelper = chat.NewHelper(g, ri)
+}
+
+type minimalistUnfurler struct{ types.DummyUnfurler }
