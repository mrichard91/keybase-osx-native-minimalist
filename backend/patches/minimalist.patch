+func TestMinimalistConstructorDoesNotStartMediaOrWalletServices(t *testing.T) {
+	tc := libkb.SetupTest(t, "minimalist-constructor", 1)
+	defer tc.Cleanup()
+	svc := NewService(tc.G, false)
+	if svc.httpSrv != nil || svc.walletState != nil {
+		t.Fatal("minimalist constructor initialized an HTTP listener or wallet worker")
+	}
+}
+
+func TestMinimalistChatRPCSurface(t *testing.T) {
+	p := minimalistChatProtocol(nil)
+	for _, required := range []string{"postLocal", "getInboxAndUnboxUILocal", "getThreadLocal", "newConversationLocal", "joinConversationByIDLocal", "markAsReadLocal", "saveUnfurlSettings"} {
+		if _, ok := p.Methods[required]; !ok {
+			t.Fatalf("required CLI method missing: %s", required)
+		}
+	}
+	for _, forbidden := range []string{"postFileAttachmentLocal", "DownloadAttachmentLocal", "DownloadFileAttachmentLocal", "makePreview", "makeAudioPreview", "getGiphyResults", "locationUpdate", "advertiseBotCommands", "forwardMessage", "postLocalNonblock", "getThreadNonblock", "addEmoji"} {
+		if _, ok := p.Methods[forbidden]; ok {
+			t.Fatalf("unexpected exposed method: %s", forbidden)
+		}
+	}
+	if len(p.Methods) != 13 {
+		t.Fatalf("review new chat methods: count=%d", len(p.Methods))
+	}
+}
+
+func TestMinimalistUnknownRPCConfigurationFailsClosed(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Fatal("missing method was silently accepted")
+		}
+	}()
+	minimalistMethods(rpc.Protocol{Name: "example", Methods: map[string]rpc.ServeHandlerDescription{}}, "missing")
+}
+
+func TestMinimalistPreviewPreferenceCannotBeEnabled(t *testing.T) {
+	u := minimalistUnfurler{}
+	settings, err := u.GetSettings(context.Background(), nil)
+	if err != nil || settings.Mode != chat1.UnfurlMode_NEVER {
+		t.Fatal("preview policy not fixed to never")
+	}
+	if u.SetMode(context.Background(), nil, chat1.UnfurlMode_ALWAYS) == nil {
+		t.Fatal("enabled previews")
+	}
+	if u.SetSettings(context.Background(), nil, chat1.UnfurlSettings{Mode: chat1.UnfurlMode_ALWAYS}) == nil {
+		t.Fatal("enabled previews through settings")
+	}
+	if u.SetMode(context.Background(), nil, chat1.UnfurlMode_NEVER) != nil {
+		t.Fatal("safe CLI settings rejected")
+	}
+}
+
+func TestMinimalistNativePreviewNeverTouchesInput(t *testing.T) {
+	// A nil reader would panic in a media decoder. Every type must be rejected
+	// before a read, even when called outside the RPC allowlist.
+	for _, mediaType := range []string{"image/jpeg", "image/gif", "image/png", "video/mp4", "audio/mpeg", "image/x-icon"} {
+		preview, err := attachments.Preview(context.Background(), utils.DebugLabeler{}, nil, mediaType, "untrusted", nil)
+		if err == nil || preview != nil {
+			t.Fatalf("media not rejected: %s", mediaType)
+		}
+	}
+}
+
+func TestMinimalistCompleteProtocolSurface(t *testing.T) {
+	protocols := minimalistProtocolSet(nil, nil, nil, nil, minimalistChatProtocol(nil))
+	expected := map[string]int{"keybase.1.config": 5, "keybase.1.login": 2, "keybase.1.signup": 3, "keybase.1.log": 1, "chat.1.local": 13}
+	if len(protocols) != len(expected) {
+		t.Fatalf("unexpected protocol count: %d", len(protocols))
+	}
+	for _, protocol := range protocols {
+		count, ok := expected[protocol.Name]
+		if !ok || len(protocol.Methods) != count {
+			t.Errorf("unexpected protocol surface %s: %d", protocol.Name, len(protocol.Methods))
+		}
+		for _, forbidden := range []string{"uploadUserAvatar", "accountDelete", "deprovision", "deviceAdd", "perfLogPoint"} {
+			if _, found := protocol.Methods[forbidden]; found {
+				t.Errorf("exposed %s.%s", protocol.Name, forbidden)
+			}
+		}
+	}
