+// The blocking official loader preserves verified ConvSource reads, pagination,
+// read-marking queries and errors. Its nonblocking rich-UI path is not needed.
+type minimalistThreadLoader struct {
+	*chat.UIThreadLoader
+}
+
+var _ types.UIThreadLoader = (*minimalistThreadLoader)(nil)
+
+func (t *minimalistThreadLoader) Load(ctx context.Context, uid gregor1.UID,
+	convID chat1.ConversationID, reason chat1.GetThreadReason, knownRemotes []string,
+	query *chat1.GetThreadQuery, pagination *chat1.Pagination,
+) (chat1.ThreadView, error) {
+	// GetThreadLocal passes nil. Do not expose its optional predecoded-remote
+	// shortcut through future callers of this deliberately narrow wrapper.
+	if len(knownRemotes) != 0 {
+		return chat1.ThreadView{}, errMinimalistDisabled
+	}
+	return t.UIThreadLoader.Load(ctx, uid, convID, reason, nil, query, pagination)
+}
+
+func (*minimalistThreadLoader) LoadNonblock(context.Context, libkb.ChatUI, gregor1.UID,
+	chat1.ConversationID, chat1.GetThreadReason, chat1.GetThreadNonblockPgMode,
+	chat1.GetThreadNonblockCbMode, []string, *chat1.GetThreadQuery, *chat1.UIPagination,
+) error {
+	return errMinimalistDisabled
+}
