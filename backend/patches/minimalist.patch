@@ -0,0 +1,22 @@
+//go:build !minimalist
+
+package attachments
+
+import (
+	"context"
+	"errors"
+	"image/gif"
+	"image/png"
+	"io"
+)
+
+func GIFToPNG(ctx context.Context, src io.Reader, dest io.Writer) error {
+	g, err := gif.DecodeAll(src)
+	if err != nil {
+		return err
+	}
+	if len(g.Image) == 0 {
+		return errors.New("no frames in gif")
+	}
+	return png.Encode(dest, g.Image[0])
+}
