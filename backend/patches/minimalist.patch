+func (d *Service) setupMinimalistChatModules(ri func() chat1.RemoteInterface) {
+	g := globals.NewContext(d.G(), d.ChatG())
+	if ri == nil {
+		ri = d.gregor.GetClient
+	}
+	storage.SetupGlobalHooks(g)
+	g.CtxFactory = chat.NewCtxFactory(g)
+	g.Badger = d.badger
+	inbox := chat.NewInboxSource(g, g.Env.GetInboxSourceType(), ri)
+	g.InboxSource = inbox
+	d.badger.SetLocalChatState(inbox)
+	chatStorage := storage.New(g, nil)
+	g.ConvSource = chat.NewConversationSource(g, g.Env.GetConvSourceType(), chat.NewBoxer(g), chatStorage, ri)
+	chatStorage.SetAssetDeleter(g.ConvSource)
+	g.Indexer = types.DummyIndexer{}
+	g.ServerCacheVersions = storage.NewServerVersions(g)
+	syncer := chat.NewSyncer(g)
+	g.Syncer = syncer
+	g.FetchRetrier = chat.NewFetchRetrier(g)
+	g.ConvLoader = chat.NewBackgroundConvLoader(g)
+	g.EphemeralPurger = chat.NewBackgroundEphemeralPurger(g)
+	g.EphemeralTracker = chat.NewEphemeralTracker(g)
+	g.AddLogoutHook(g.EphemeralTracker, "EphemeralTracker")
+	g.AddDbNukeHook(g.EphemeralTracker, "EphemeralTracker")
+	g.ActivityNotifier = chat.NewNotifyRouterActivityRouter(g)
+	d.badger.SetInboxVersionSource(storage.NewInboxVersionSource(g))
+	g.PushHandler = chat.NewPushHandler(g)
+	g.AttachmentUploader = types.DummyAttachmentUploader{}
+	g.AttachmentURLSrv = types.DummyAttachmentHTTPSrv{}
+	sender := chat.NewBlockingSender(g, chat.NewBoxer(g), ri)
+	g.MessageDeliverer = chat.NewDeliverer(g, sender, d.gregor)
+	g.TeamChannelSource = chat.NewTeamChannelSource(g)
+	g.AddLogoutHook(g.TeamChannelSource, "TeamChannelSource")
+	g.AddDbNukeHook(g.TeamChannelSource, "TeamChannelSource")
+	g.StellarLoader = types.DummyStellarLoader{}
+	g.StellarSender = types.DummyStellarSender{}
+	g.Unfurler = minimalistUnfurler{}
+	g.CommandsSource = minimalistCommands{}
+	g.CoinFlipManager = types.DummyCoinFlipManager{}
+	g.TeamMentionLoader = types.DummyTeamMentionLoader{}
+	g.ExternalAPIKeySource = types.DummyExternalAPIKeySource{}
+	g.LiveLocationTracker = minimalistLocation{}
+	g.BotCommandManager = types.DummyBotCommandManager{}
+	g.UIInboxLoader = types.DummyUIInboxLoader{}
+	g.UIThreadLoader = types.DummyUIThreadLoader{}
+	g.ParticipantsSource = chat.NewCachingParticipantSource(g, ri)
+	g.EmojiSource = types.DummyEmojiSource{}
+	syncer.RegisterOfflinable(g.InboxSource)
+	syncer.RegisterOfflinable(g.FetchRetrier)
+	syncer.RegisterOfflinable(g.MessageDeliverer)
+	g.AddUserChangedHandler(chat.NewIdentifyChangedHandler(g))
+	g.ChatHelper = chat.NewHelper(g, ri)
+}
