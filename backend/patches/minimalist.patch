+//go:build minimalist
+
+package libkb
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestMinimalistSeparateStorageNamespace(t *testing.T) {
+	env := newEnv(AppConfig{HomeDir: t.TempDir(), RunMode: ProductionRunMode}, nil, "darwin", nil)
+	for _, path := range []string{env.GetConfigDir(), env.GetDataDir(), env.GetRuntimeDir()} {
+		if !strings.Contains(strings.ToLower(path), "keybase-minimalist") {
+			t.Fatalf("storage not isolated: %s", path)
+		}
+	}
+	if env.GetStoredSecretServiceName() != "keybase-minimalist" {
+		t.Fatal("Keychain namespace is not isolated")
+	}
+}
