+// Only Pull is implemented: an accidental rich/background callback fails the
+// test instead of silently succeeding through another dummy method.
+type minimalistReadSource struct {
+	types.ConversationSource
+	pull func(context.Context, chat1.ConversationID, gregor1.UID, chat1.GetThreadReason,
+		func() chat1.RemoteInterface, *chat1.GetThreadQuery, *chat1.Pagination) (chat1.ThreadView, error)
+}
+
+func (s minimalistReadSource) Pull(ctx context.Context, convID chat1.ConversationID,
+	uid gregor1.UID, reason chat1.GetThreadReason, ri func() chat1.RemoteInterface,
+	query *chat1.GetThreadQuery, pagination *chat1.Pagination,
+) (chat1.ThreadView, error) {
+	return s.pull(ctx, convID, uid, reason, ri, query, pagination)
+}
+
+type minimalistReadRemote struct{ chat1.RemoteInterface }
+
+func TestMinimalistThreadReadWiring(t *testing.T) {
+	t.Setenv("KEYBASE_SECRET_STORE_FILE", "1")
+	tc := libkb.SetupTest(t, "minimalist-thread-read", 1)
+	defer tc.Cleanup()
+	tc.G.SetService()
+	svc := NewService(tc.G, false)
+	remote := &minimalistReadRemote{}
+	svc.setupMinimalistChatModules(func() chat1.RemoteInterface { return remote })
+	g := svc.ChatG()
+	uid := gregor1.UID{1, 2, 3}
+	convID := chat1.ConversationID{4, 5, 6}
+	query := &chat1.GetThreadQuery{MarkAsRead: false}
+	pagination := &chat1.Pagination{Num: 100, Next: []byte("request-page")}
+	expected := chat1.ThreadView{
+		Messages: []chat1.MessageUnboxed{chat1.NewMessageUnboxedWithValid(chat1.MessageUnboxedValid{
+			ServerHeader: chat1.MessageServerHeader{MessageID: 42},
+			MessageBody:  chat1.NewMessageBodyWithText(chat1.MessageText{Body: "synthetic verified text"}),
+		})},
+		Pagination: &chat1.Pagination{Next: []byte("next-page"), Last: false},
+	}
+	calls := 0
+	var sourceErr error
+	g.ConvSource = minimalistReadSource{pull: func(_ context.Context, gotConv chat1.ConversationID,
+		gotUID gregor1.UID, reason chat1.GetThreadReason, ri func() chat1.RemoteInterface,
+		gotQuery *chat1.GetThreadQuery, gotPagination *chat1.Pagination,
+	) (chat1.ThreadView, error) {
+		calls++
+		if !reflect.DeepEqual(gotConv, convID) || !reflect.DeepEqual(gotUID, uid) ||
+			reason != chat1.GetThreadReason_GENERAL || ri() != remote ||
+			gotQuery != query || gotPagination != pagination {
+			t.Fatal("thread loader changed the verified source request")
+		}
+		return expected, sourceErr
+	}}
+	ctx := context.Background()
+	for _, markRead := range []bool{false, true} {
+		query.MarkAsRead = markRead
+		thread, err := g.UIThreadLoader.Load(ctx, uid, convID, chat1.GetThreadReason_GENERAL, nil, query, pagination)
+		if err != nil || !reflect.DeepEqual(thread, expected) || len(thread.Messages) != 1 {
+			t.Fatalf("thread result was lost: %#v, %v", thread, err)
+		}
+		if query.MarkAsRead != markRead {
+			t.Fatal("read-marking preference changed")
+		}
+	}
+	sourceErr = errors.New("synthetic identity/network failure")
+	if _, err := g.UIThreadLoader.Load(ctx, uid, convID, chat1.GetThreadReason_GENERAL, nil, query, pagination); !errors.Is(err, sourceErr) {
+		t.Fatalf("source failure was swallowed: %v", err)
+	}
+	if calls != 3 {
+		t.Fatalf("verified source was not reached: calls=%d", calls)
+	}
+	g.UIThreadLoader.Disconnected(ctx)
+	if !g.UIThreadLoader.IsOffline(ctx) {
+		t.Fatal("offline state was discarded")
+	}
+	g.UIThreadLoader.Connected(ctx)
+	if g.UIThreadLoader.IsOffline(ctx) {
+		t.Fatal("reconnect state was discarded")
+	}
+	if _, err := g.UIThreadLoader.Load(ctx, uid, convID, chat1.GetThreadReason_GENERAL, []string{"untrusted remote shortcut"}, query, pagination); !errors.Is(err, errMinimalistDisabled) {
+		t.Fatal("known-remote parsing shortcut was allowed")
+	}
+	if err := g.UIThreadLoader.LoadNonblock(ctx, nil, uid, convID, chat1.GetThreadReason_GENERAL, 0, 0, nil, query, nil); !errors.Is(err, errMinimalistDisabled) {
+		t.Fatal("nonblocking rich thread loading was allowed")
+	}
+	if calls != 3 {
+		t.Fatal("disabled rich loading reached the conversation source")
+	}
+}
