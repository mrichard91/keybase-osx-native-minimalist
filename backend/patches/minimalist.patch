diff --git a/go/chat/minimalist_policy.go b/go/chat/minimalist_policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..255954d39c983c74eca6e1b9aed630a1cef25d89
--- /dev/null
+++ b/go/chat/minimalist_policy.go
@@ -0,0 +1,71 @@
+package chat
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/keybase/client/go/libkb"
+	"github.com/keybase/client/go/protocol/chat1"
+)
+
+var errMinimalistUnsupported = errors.New("operation disabled in minimalist backend: only private ASCII text chat is supported")
+
+// This policy is fixed at compile time. A command-line flag or account setting
+// cannot enable rich message processing in the minimalist service.
+func validateMinimalistText(msg chat1.MessagePlaintext) error {
+	if !libkb.IsMinimalistBuild {
+		return nil
+	}
+	if msg.ClientHeader.TlfPublic || msg.ClientHeader.EphemeralMetadata != nil ||
+		(msg.ClientHeader.Conv.TopicType != chat1.TopicType_CHAT && msg.ClientHeader.Conv.TopicType != chat1.TopicType_NONE) ||
+		msg.ClientHeader.MessageType != chat1.MessageType_TEXT {
+		return errMinimalistUnsupported
+	}
+	typ, err := msg.MessageBody.MessageType()
+	if err != nil || typ != chat1.MessageType_TEXT {
+		return errMinimalistUnsupported
+	}
+	text := msg.MessageBody.Text()
+	if len(text.Body) == 0 || len(text.Body) > 10000 || strings.TrimSpace(text.Body) == "" ||
+		len(text.Payments) != 0 ||
+		text.LiveLocation != nil || len(text.Emojis) != 0 || len(text.TeamMentions) != 0 ||
+		len(text.UserMentions) != 0 || text.ReplyTo != nil || text.ReplyToUID != nil {
+		return errMinimalistUnsupported
+	}
+	for _, ch := range []byte(text.Body) {
+		if ch != '\n' && (ch < 32 || ch > 126) {
+			return errMinimalistUnsupported
+		}
+	}
+	return nil
+}
+
+// Sender.Prepare is also reached by old queued items and internal helpers, not
+// only user RPCs. Keep the few control messages required to create/join a chat;
+// reject media here so an old outbox cannot bypass the user-facing text gate.
+func validateMinimalistSend(msg chat1.MessagePlaintext, conv *chat1.ConversationLocal) error {
+	if !libkb.IsMinimalistBuild {
+		return nil
+	}
+	if msg.ClientHeader.TlfPublic || (conv != nil && (conv.IsPublic() || conv.GetTopicType() != chat1.TopicType_CHAT)) {
+		return errMinimalistUnsupported
+	}
+	if conv == nil && msg.ClientHeader.Conv.TopicType != chat1.TopicType_CHAT {
+		return errMinimalistUnsupported
+	}
+	bodyType, err := msg.MessageBody.MessageType()
+	if err != nil || (bodyType != msg.ClientHeader.MessageType &&
+		!(msg.ClientHeader.MessageType == chat1.MessageType_TLFNAME && bodyType == chat1.MessageType_NONE)) {
+		return errMinimalistUnsupported
+	}
+	switch msg.ClientHeader.MessageType {
+	case chat1.MessageType_TEXT:
+		return validateMinimalistText(msg)
+	case chat1.MessageType_TLFNAME, chat1.MessageType_METADATA, chat1.MessageType_JOIN,
+		chat1.MessageType_LEAVE, chat1.MessageType_SYSTEM, chat1.MessageType_DELETE,
+		chat1.MessageType_DELETEHISTORY:
+		return nil
+	default:
+		return errMinimalistUnsupported
+	}
+}
diff --git a/go/chat/minimalist_policy_test.go b/go/chat/minimalist_policy_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..61af23ec2b2dd5eef5f802865ac95d6b9b7c3ef4
--- /dev/null
+++ b/go/chat/minimalist_policy_test.go
@@ -0,0 +1,126 @@
+//go:build minimalist
+
+package chat
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/keybase/client/go/protocol/chat1"
+	"github.com/keybase/client/go/protocol/keybase1"
+)
+
+func minimalistTextMessage(body string) chat1.MessagePlaintext {
+	return chat1.MessagePlaintext{
+		ClientHeader: chat1.MessageClientHeader{
+			Conv:        chat1.ConversationIDTriple{TopicType: chat1.TopicType_CHAT},
+			MessageType: chat1.MessageType_TEXT,
+		},
+		MessageBody: chat1.NewMessageBodyWithText(chat1.MessageText{Body: body}),
+	}
+}
+
+func TestMinimalistTextBoundary(t *testing.T) {
+	for _, body := range []string{"hello", "hello\nworld", "/giphy dogs", "\n/flip", "18:00:00", "<b>plain</b>", ":custom-emoji:", "+1XLM@alice", "https://giphy.com/test"} {
+		if err := validateMinimalistText(minimalistTextMessage(body)); err != nil {
+			t.Errorf("safe literal text rejected: %q: %v", body, err)
+		}
+	}
+	for _, body := range []string{"", " \n ", "hello 😀", "hello\tworld", "bad\x1b[31m", strings.Repeat("a", 10001)} {
+		if err := validateMinimalistText(minimalistTextMessage(body)); err == nil {
+			t.Errorf("unsafe text accepted: %q", body)
+		}
+	}
+}
+
+func TestMinimalistRejectsTypedExtrasAndPublicTopics(t *testing.T) {
+	cases := []func(*chat1.MessagePlaintext){
+		func(m *chat1.MessagePlaintext) { m.ClientHeader.TlfPublic = true },
+		func(m *chat1.MessagePlaintext) { m.ClientHeader.Conv.TopicType = chat1.TopicType_DEV },
+		func(m *chat1.MessagePlaintext) { m.ClientHeader.MessageType = chat1.MessageType_ATTACHMENT },
+		func(m *chat1.MessagePlaintext) { m.ClientHeader.EphemeralMetadata = &chat1.MsgEphemeralMetadata{} },
+		func(m *chat1.MessagePlaintext) {
+			m.MessageBody = chat1.NewMessageBodyWithText(chat1.MessageText{Body: "hello", LiveLocation: &chat1.LiveLocation{}})
+		},
+		func(m *chat1.MessagePlaintext) {
+			m.MessageBody = chat1.NewMessageBodyWithText(chat1.MessageText{Body: "hello", Payments: []chat1.TextPayment{{}}})
+		},
+		func(m *chat1.MessagePlaintext) {
+			m.MessageBody = chat1.NewMessageBodyWithText(chat1.MessageText{Body: "hello", Emojis: map[string]chat1.HarvestedEmoji{"custom": {}}})
+		},
+	}
+	for i, mutate := range cases {
+		m := minimalistTextMessage("hello")
+		mutate(&m)
+		if err := validateMinimalistText(m); err == nil {
+			t.Errorf("case %d accepted", i)
+		}
+		// These fail before any credentials, contexts, or service callbacks are touched.
+		server := &Server{}
+		if _, err := server.PostLocal(context.Background(), chat1.PostLocalArg{Msg: m}); err == nil {
+			t.Errorf("PostLocal case %d accepted", i)
+		}
+		if _, err := server.PostLocalNonblock(context.Background(), chat1.PostLocalNonblockArg{Msg: m}); err == nil {
+			t.Errorf("PostLocalNonblock case %d accepted", i)
+		}
+	}
+}
+
+func TestMinimalistInternalConversationControlMessagesRemainAvailable(t *testing.T) {
+	for _, m := range []chat1.MessagePlaintext{
+		{ClientHeader: chat1.MessageClientHeader{Conv: chat1.ConversationIDTriple{TopicType: chat1.TopicType_CHAT}, MessageType: chat1.MessageType_TLFNAME}},
+		{ClientHeader: chat1.MessageClientHeader{Conv: chat1.ConversationIDTriple{TopicType: chat1.TopicType_CHAT}, MessageType: chat1.MessageType_METADATA}, MessageBody: chat1.NewMessageBodyWithMetadata(chat1.MessageConversationMetadata{ConversationTitle: "general"})},
+		{ClientHeader: chat1.MessageClientHeader{Conv: chat1.ConversationIDTriple{TopicType: chat1.TopicType_CHAT}, MessageType: chat1.MessageType_JOIN}, MessageBody: chat1.NewMessageBodyWithJoin(chat1.MessageJoin{})},
+	} {
+		if err := validateMinimalistSend(m, nil); err != nil {
+			t.Errorf("required control rejected: %v", err)
+		}
+		if err := validateMinimalistText(m); err == nil {
+			t.Error("internal control allowed through user text RPC")
+		}
+	}
+}
+
+func TestMinimalistOutboxAndVerifiedConversationBoundary(t *testing.T) {
+	media := minimalistTextMessage("hello")
+	media.ClientHeader.MessageType = chat1.MessageType_ATTACHMENT
+	media.MessageBody = chat1.NewMessageBodyWithAttachment(chat1.MessageAttachment{})
+	if err := validateMinimalistSend(media, nil); err == nil {
+		t.Error("old media outbox item accepted")
+	}
+	if _, err := (&BlockingSender{}).Prepare(context.Background(), media, chat1.ConversationMembersType_TEAM, nil, nil); err == nil {
+		t.Error("media reached sender callbacks")
+	}
+	conv := chat1.ConversationLocal{Info: chat1.ConversationInfoLocal{Triple: chat1.ConversationIDTriple{TopicType: chat1.TopicType_CHAT}, Visibility: keybase1.TLFVisibility_PUBLIC}}
+	if err := validateMinimalistSend(minimalistTextMessage("hello"), &conv); err == nil {
+		t.Error("forged private header sent to public conversation")
+	}
+	spoof := minimalistTextMessage("hello")
+	spoof.ClientHeader.MessageType = chat1.MessageType_TLFNAME
+	if err := validateMinimalistSend(spoof, nil); err == nil {
+		t.Error("body hidden behind control header accepted")
+	}
+}
+
+func TestMinimalistEmojiPathCannotReachSource(t *testing.T) {
+	msg := minimalistTextMessage(":custom-emoji:")
+	// A nil contextified sender would panic if it touched the emoji source.
+	result, err := (&BlockingSender{}).handleEmojis(context.Background(), nil, nil, msg, chat1.TopicType_CHAT)
+	if err != nil || result.MessageBody.Text().Body != ":custom-emoji:" {
+		t.Fatalf("literal emoji send changed: %v", err)
+	}
+}
+
+func TestMinimalistIncomingExtrasCannotReachMediaOrJourneyServices(t *testing.T) {
+	// These paths are reachable from a normal inbox/thread read or retention
+	// event; a nil context catches accidental service lookups immediately.
+	source := &baseConversationSource{}
+	thread := chat1.ThreadView{}
+	source.addConversationCards(context.Background(), nil, chat1.GetThreadReason_GENERAL, nil, nil, &thread)
+	source.addPendingPreviews(context.Background(), &thread)
+	source.DeleteAssets(context.Background(), nil, nil, []chat1.Asset{{}})
+	if len(thread.Messages) != 0 {
+		t.Fatal("incoming decoration changed the thread")
+	}
+}
