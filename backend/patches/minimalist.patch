+// No attachment, wallet, filesystem, browser helper, search, bot or debugging
+// protocol is registered. Unknown methods fail before their request is decoded.
+func (d *Service) registerMinimalistProtocols(srv *rpc.Server, xp rpc.Transporter, connID libkb.ConnectionID, logReg *logRegister) error {
+	g := d.G()
+	cg := globals.NewContext(g, d.ChatG())
+	protocols := minimalistProtocolSet(
+		NewConfigHandler(xp, connID, g, d), NewLoginHandler(xp, g),
+		NewSignupHandler(xp, g), NewLogHandler(xp, logReg, g),
+		CancelingProtocol(g, minimalistChatProtocol(newChatLocalHandler(xp, cg, d.gregor)), libkb.RPCCancelerReasonAll))
+	for _, protocol := range protocols {
+		if err := srv.Register(protocol); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// The official CLI account flow uses these RPC entry points. Its engines
+// perform identity, device and key operations directly within the service;
+// registering the unrelated User/Device administration protocols is unnecessary.
+func minimalistProtocolSet(config keybase1.ConfigInterface, login keybase1.LoginInterface,
+	signup keybase1.SignupInterface, log keybase1.LogInterface, chatProtocol rpc.Protocol) []rpc.Protocol {
+	return []rpc.Protocol{
+		minimalistMethods(keybase1.ConfigProtocol(config), "getCurrentStatus", "getConfig", "helloIAm", "getAllProvisionedUsernames", "getRememberPassphrase"),
+		minimalistMethods(keybase1.LoginProtocol(login), "login", "logout"),
+		minimalistMethods(keybase1.SignupProtocol(signup), "signup", "inviteRequest", "getInvitationCode"),
+		minimalistMethods(keybase1.LogProtocol(log), "registerLogger"),
+		chatProtocol,
+	}
+}
+
+func minimalistChatProtocol(handler chat1.LocalInterface) rpc.Protocol {
+	return minimalistMethods(chat1.LocalProtocol(handler),
+		"getThreadLocal", "getInboxAndUnboxLocal", "getInboxAndUnboxUILocal", "getInboxSummaryForCLILocal", "getConversationForCLILocal",
+		"findConversationsLocal", "newConversationLocal", "getTLFConversationsLocal", "joinConversationByIDLocal",
+		"markAsReadLocal", "postLocal", "getUnfurlSettings", "saveUnfurlSettings")
+}
+
+func minimalistMethods(protocol rpc.Protocol, names ...string) rpc.Protocol {
+	methods := make(map[string]rpc.ServeHandlerDescription, len(names))
+	for _, name := range names {
+		if method, ok := protocol.Methods[name]; ok {
+			methods[name] = method
+		} else {
+			panic("minimalist protocol contains unknown method: " + protocol.Name + "." + name)
+		}
+	}
+	protocol.Methods = methods
+	return protocol
+}
