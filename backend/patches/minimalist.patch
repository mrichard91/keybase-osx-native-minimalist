@@ -0,0 +1,53 @@
+//go:build minimalist
+
+package client
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/keybase/client/go/libkb"
+	"github.com/keybase/client/go/protocol/keybase1"
+)
+
+func TestMinimalistMobileProvisioningDisplaysPhraseWithoutQRCode(t *testing.T) {
+	tmpDir := t.TempDir()
+	t.Setenv("TMPDIR", tmpDir)
+	for _, role := range []libkb.KexRole{libkb.KexRoleProvisioner, libkb.KexRoleProvisionee} {
+		var plain, unescaped bytes.Buffer
+		p := ProvisionUI{role: role, parent: &UI{outputWriter: &plain, unescapedOutputWriter: &unescaped}}
+		const phrase = "synthetic verification phrase"
+		_, err := p.DisplayAndPromptSecret(context.Background(), keybase1.DisplayAndPromptSecretArg{
+			OtherDeviceType: keybase1.DeviceType_MOBILE,
+			Phrase:          phrase,
+		})
+		if err != nil || !strings.Contains(plain.String(), phrase) {
+			t.Fatalf("mobile provisioning phrase missing for role %v: %v", role, err)
+		}
+		if unescaped.Len() != 0 || strings.Contains(plain.String(), "PNG") || strings.Contains(plain.String(), "QR Code") {
+			t.Fatalf("mobile provisioning rendered a QR code for role %v", role)
+		}
+		for _, b := range plain.Bytes() {
+			if b > 127 {
+				t.Fatal("non-ASCII provisioning output")
+			}
+		}
+	}
+	entries, err := os.ReadDir(tmpDir)
+	if err != nil || len(entries) != 0 {
+		t.Fatalf("provisioning wrote a secret image: entries=%v err=%v", entries, err)
+	}
+}
+
+func TestMinimalistAPIDeniesExtraFeaturesBeforeHandler(t *testing.T) {
+	handler := ChatAPIVersionHandler{}
+	for _, method := range []string{"attach", "download", "reaction", "emojiadd", "loadflip", "advertisecommands", "searchinbox", "delete", "unknown"} {
+		if err := handler.handleV1(context.Background(), Call{Method: method}, io.Discard); err == nil {
+			t.Fatalf("disabled API method reached handler: %s", method)
+		}
+	}
+}
